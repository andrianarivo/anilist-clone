{
	"cli": {
		"version": ">= 3.4.0",
		"promptToConfigurePushNotifications": false,
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"env": {
				"EAS_NO_VCS": "1"
			},
			"developmentClient": true,
			"distribution": "internal",
			"ios": {
				"resourceClass": "m1-medium"
			}
		},
		"preview": {
			"distribution": "internal",
			"ios": {
				"resourceClass": "m1-medium"
			},
			"android": {
				"buildType": "apk"
			}
		},
		"production": {
			"autoIncrement": true,
			"env": {
				"EXPO_PUBLIC_ANILIST_API_URL": "https://graphql.anilist.co"
			},
			"android": {
				"buildType": "app-bundle"
			}
		}
	},
	"submit": {
		"production": {
			"android": {
				"serviceAccountKeyPath": "./google-service-account-key.json",
				"track": "internal",
				"releaseStatus": "draft"
			}
		}
	}
}
